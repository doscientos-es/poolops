---
import { site } from '../config/site';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#092c34">
    <title>{site.title}</title>
    <meta name="description" content={site.description}>
    <link rel="canonical" href={site.url}>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="es_ES">
    <meta property="og:site_name" content={site.name}>
    <meta property="og:title" content={site.socialTitle}>
    <meta property="og:description" content="Una forma más sencilla de organizar el trabajo, los clientes y los cobros de tu empresa de piscinas.">
    <meta property="og:url" content={site.url}>
    <meta name="twitter:card" content="summary">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://images.unsplash.com">
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <svg class="icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></symbol>
      <symbol id="icon-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></symbol>
      <symbol id="icon-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4m10-4v4M3 10h18m-13 4h.01M12 14h.01M16 14h.01M8 17h.01M12 17h.01" /></symbol>
      <symbol id="icon-drop" viewBox="0 0 24 24"><path d="M12 3s-6.5 6.5-6.5 11.2a6.5 6.5 0 0 0 13 0C18.5 9.5 12 3 12 3Z" /><path d="M9 15a3 3 0 0 0 3 3" /></symbol>
      <symbol id="icon-document" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v5h5M9 12h6M9 16h6" /></symbol>
      <symbol id="icon-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3" /><path d="M3 20v-2a6 6 0 0 1 12 0v2M16 5a3 3 0 0 1 0 6m1 3a5 5 0 0 1 4 5v1" /></symbol>
      <symbol id="icon-wallet" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="15" rx="2" /><path d="M3 9h18m-5 5h5m-5 0a2 2 0 0 0 0 4h5" /></symbol>
    </svg>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="PoolOps, inicio">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>pool<span class="brand-accent">ops</span><span class="brand-dot">.</span></span>
        </a>
        <nav class="main-nav" aria-label="Navegación principal">
          <a href="#ventajas">Qué ganas</a>
          <a href="#como-funciona">Cómo te ayuda</a>
          <a href="#preguntas">Preguntas frecuentes</a>
        </nav>
        <a class="header-cta" href={site.appUrl}>Probar PoolOps <svg class="icon" aria-hidden="true"><use href="#icon-arrow" /></svg></a>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-main">
        <div>
          <a class="brand footer-brand" href="/" aria-label="PoolOps, inicio"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>pool<span class="brand-accent">ops</span><span class="brand-dot">.</span></span></a>
          <p>Una forma más clara de cuidar<br>tu negocio de piscinas.</p>
        </div>
        <div class="footer-links">
          <div><span>EXPLORA</span><a href="#ventajas">Ventajas</a><a href="#como-funciona">Cómo funciona</a><a href="#preguntas">Preguntas frecuentes</a></div>
          <div><span>EL PRODUCTO</span><a href={site.appUrl}>Descubrir PoolOps ↗</a><a href="https://doscientos.es">Doscientos ↗</a></div>
        </div>
      </div>
      <div class="container footer-bottom"><span>PoolOps es Ábaco para profesionales de piscinas.</span><span>Un producto de <a href="https://doscientos.es">Doscientos</a> · © 2026</span></div>
    </footer>
  </body>
</html>